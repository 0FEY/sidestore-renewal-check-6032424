+    private func renewOriginalProfile(_ original: ALTProvisioningProfile, for app: ALTApplication, team: ALTTeam) async throws -> ALTProvisioningProfile {
+        let deviceID = original.deviceIDs.count == 1 ? original.deviceIDs.first : try? await fetchUDID(useStatic: true)
+        if let deviceID {
+            _ = try await TaskChainCoalescer.shared.coalesce(key: "original_device_\(team.identifier)_\(deviceID)") {
+                let devices = try await DeveloperPortalProxy.shared.fetchDevices(for: team, types: .all)
+                if !devices.contains(where: { $0.identifier == deviceID }) {
+                    try await DeveloperPortalProxy.shared.registerDevice(name: "iPhone", identifier: deviceID, type: DeveloperPortalProxy.currentDeviceType, team: team)
+                }
+                return true
+            }
+        }
+        let appID = try await self.registerAppID(for: app, name: app.name, bundleIdentifier: original.bundleIdentifier, team: team)
+        let prepared = try await self.updateFeatures(for: appID, targetAppBundle: app, team: team)
+        let originalGroups = Set(original.entitlements[.appGroups] as? [String] ?? [])
+        if !originalGroups.isEmpty {
+            var groups = [ALTAppGroup]()
+            for identifier in originalGroups.sorted() {
+                let group = try await TaskChainCoalescer.shared.coalesce(key: "original_group_\(team.identifier)_\(identifier)") {
+                    let registered = try await DeveloperPortalProxy.shared.fetchAppGroups(for: team)
+                    if let existing = registered.first(where: { $0.groupIdentifier == identifier }) {
+                        return existing
+                    }
+                    return try await DeveloperPortalProxy.shared.addAppGroup(name: "SideStore original group", groupIdentifier: identifier, team: team)
+                }
+                groups.append(group)
+            }
+            try await DeveloperPortalProxy.shared.assignAppID(prepared, to: groups, team: team)
+        }
+        let profile = try await DeveloperPortalProxy.shared.downloadProvisioningProfile(for: prepared, deviceType: DeveloperPortalProxy.currentDeviceType, team: team)
+        let originalCertificates = Set(original.certificates.map { $0.serialNumber })
+        guard profile.bundleIdentifier == original.bundleIdentifier,
+              profile.teamIdentifier == original.teamIdentifier,
+              Set(profile.entitlements[.appGroups] as? [String] ?? []) == originalGroups,
+              Set(profile.deviceIDs).isSuperset(of: original.deviceIDs),
+              originalCertificates.isSubset(of: profile.certificates.map { $0.serialNumber }) else {
+            throw OperationError.invalidParameters("The renewed profile changed the original app's signing scope.")
+        }
+        return profile
+    }
