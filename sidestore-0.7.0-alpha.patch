+        if parent == nil {
+            targetBundle = signed
+        } else {
+            let prefix = base.bundleIdentifier + "."
+            guard target.bundleIdentifier.hasPrefix(prefix),
+                  let installedExtension = signed.appExtensions.first(where: {
+                      $0.bundleIdentifier == signed.bundleIdentifier + "." + target.bundleIdentifier.dropFirst(prefix.count)
+                  }) else {
+                throw OperationError.invalidParameters("The signed app extension could not be matched.")
+            }
+            targetBundle = installedExtension
+        }
+
+        guard let profile = targetBundle.provisioningProfile,
+              profile.bundleIdentifier == targetBundle.bundleIdentifier,
+              profile.teamIdentifier == team.identifier else {
+            throw OperationError.invalidParameters("Use the developer team that signed this app.")
+        }
+        return profile
+    }
